{"description":"Sentra Frontier — multimodal workspace intelligence for the Meta Global AI Developer Hackathon (Startup Track, Push the Frontier).","devDependencies":{"@types/node":"^24.0.0","typescript":"^5.6.0"},"name":"sentra-frontier","private":true,"type":"module","scripts":{"build":"npm run server:build && npm run web:build","server:build":"tsc -p server/tsconfig.json","server:start":"node server/dist/server.js","server:start:envfile":"node --env-file=.env server/dist/server.js","server:test":"npm run server:build && node --test server/dist/*.test.js","test":"npm run server:test","web:build":"npm --prefix web run build","web:dev":"npm --prefix web run dev","web:install":"npm --prefix web install"},"version":"0.1.0","dependencies":{"@meta-sam/parser":"^0.1.0"}}
# Copy to .env — never commit a real key. The server reads these only;
# the browser bundle never receives them.
# Meta Model API key (from the Meta developer dashboard at dev.meta.ai).
# Official env var name is MODEL_API_KEY; META_API_KEY is accepted as a
# fallback for Phase 1 setups. Leave both unset for clearly labeled
# fixture mode. Never paste a key into chat.
MODEL_API_KEY=
# META_API_KEY=
# Base URL for the Meta Model API (OpenAI-compatible surface).
META_API_BASE_URL=https://api.meta.ai/v1
# Optional advanced reasoning. Only used when true AND a key is configured.
META_WONDER_ENABLED=false
# Optional approval protection. When set, approve/reject require the
# X-Frontier-Approval-Token header with this value. When unset, approval
# endpoints are open (demo default) and /api/meta/status reports "open".
FRONTIER_APPROVAL_TOKEN=
# Billable-endpoint protection (Phase 1C). Default is localhost-only:
# /api/meta/test and /api/analyze refuse non-loopback clients. Set this
# to "true" ONLY for a deployment where FRONTIER_APPROVAL_TOKEN is also
# set — then billable endpoints require that token header. If this is
# "true" without a token, billable endpoints are refused outright
# ("misconfigured") rather than served unprotected.
FRONTIER_ALLOW_PUBLIC_BILLABLE=false
# Per-IP billable requests allowed per minute (default 30).
FRONTIER_BILLABLE_RATE_LIMIT_PER_MINUTE=30
# Interface the API binds to (Phase 1D). Default 127.0.0.1 (loopback
# only). Set to 0.0.0.0 ONLY deliberately for a network deployment —
# the billable guard still blocks non-loopback billable clients, but
# binding publicly is a separate, reviewable decision. Do not deploy
# publicly without founder approval and real authorization.
FRONTIER_BIND_HOST=127.0.0.1
# Optional persistence directory. Default: server/data/ (analyses.json +
# audit.jsonl, gitignored, single-user demo storage — not a production DB).
FRONTIER_DATA_DIR=
# Server port.
PORT=4000
